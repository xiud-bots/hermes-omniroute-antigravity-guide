# ==============================================================================
# Variáveis de Ambiente do Hermes Agent
# Arquivo de Destino: ~/.hermes/.env (chmod 600)
# ==============================================================================

# Chave de API gerada no OmniRoute (Dashboard -> API Keys -> Create Key)
OPENAI_API_KEY=sk-sua-chave-gerada-no-omniroute-aqui

# (Opcional) Chave de busca na web se utilizar provedores externos
# TAVILY_API_KEY=tvly-...
# FIRECRAWL_API_KEY=fc-...

# (Opcional) Integrações de Git/GitHub
# GITHUB_TOKEN=ghp_...
